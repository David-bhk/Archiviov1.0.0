# Generate a unique, high-entropy value for every deployment.
JWT_SECRET=

# Dedicated PostgreSQL service for Archivio. Keep the password only in the
# local .env file; Compose refuses to start when it is empty or missing.
ARCHIVIO_DB_PROVIDER=sqlite
ARCHIVIO_DB_HOST=127.0.0.1
ARCHIVIO_DB_NAME=archivio
ARCHIVIO_DB_USER=archivio
ARCHIVIO_DB_PASSWORD=
ARCHIVIO_DB_PORT=5433

# Set ARCHIVIO_DB_PROVIDER=postgresql only for an explicit validation or cutover.
# The application constructs the connection URL in memory and never logs it.

# Optional server settings. PORT and HOST control the listening address.
PORT=5000
HOST=0.0.0.0
UPLOADS_DIR=uploads

# Reserved for the future CORS configuration unit; origins are not yet read
# from this variable by the server.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
