# Generate a unique, high-entropy value for every deployment.
JWT_SECRET=

# Dedicated PostgreSQL service for Archivio. Keep the password only in the
# local .env file; Compose refuses to start when it is empty or missing.
ARCHIVIO_DB_NAME=archivio
ARCHIVIO_DB_USER=archivio
ARCHIVIO_DB_PASSWORD=
ARCHIVIO_DB_PORT=5433

# Reserved for the PostgreSQL cutover. The current SQLite application does not
# consume this value yet. Percent-encode special password characters in URLs.
# DATABASE_URL=postgresql://archivio:PASSWORD@127.0.0.1:5433/archivio?schema=public

# Optional deployment settings. Current defaults remain in the server code
# until the dedicated configuration unit moves them behind validated variables.
PORT=5000
UPLOADS_DIR=uploads
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
